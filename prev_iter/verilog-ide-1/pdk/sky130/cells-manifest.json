{
  "pdkId": "sky130",
  "library": "sky130_fd_sc_hd",
  "description": "SkyWater 130nm High-Density standard cell library",
  "powerPorts": ["VPWR","VGND","VPB","VNB"],
  "powerNets":  {"VPWR":"1'b1","VGND":"1'b0","VPB":"1'b1","VNB":"1'b0"},
  "supplyVoltage": 1.8,
  "tempCorner": "tt_025C",
  "cells": [
    {"id":"sky130_and2","abstract":"AND2","cell":"sky130_fd_sc_hd__and2_1","drive":"1","category":"combinational/gates","label":"AND2","symbol":"AND","color":"#4ade80","ports":{"inputs":[{"name":"A","width":1},{"name":"B","width":1}],"outputs":[{"name":"X","width":1}]},"logic":"X = A & B","description":"2-input AND gate (drive strength 1).","tutorial":"sky130_fd_sc_hd__and2_1 implements X=A&B. Drive strength 1 = ~240µA. Use _2/_4 variants for heavier loads.","verilogSnippet":"sky130_fd_sc_hd__and2_1 {inst} (.A({A}), .B({B}), .X({X}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tpd_typ":0.15,"unit":"ns"}},
    {"id":"sky130_and3","abstract":"AND3","cell":"sky130_fd_sc_hd__and3_1","drive":"1","category":"combinational/gates","label":"AND3","symbol":"AND3","color":"#4ade80","ports":{"inputs":[{"name":"A","width":1},{"name":"B","width":1},{"name":"C","width":1}],"outputs":[{"name":"X","width":1}]},"logic":"X = A & B & C","description":"3-input AND gate.","tutorial":"3-input AND: X=A&B&C. Internally two stacked NAND2+INV stages in sky130.","verilogSnippet":"sky130_fd_sc_hd__and3_1 {inst} (.A({A}), .B({B}), .C({C}), .X({X}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tpd_typ":0.22,"unit":"ns"}},
    {"id":"sky130_or2","abstract":"OR2","cell":"sky130_fd_sc_hd__or2_1","drive":"1","category":"combinational/gates","label":"OR2","symbol":"OR","color":"#4ade80","ports":{"inputs":[{"name":"A","width":1},{"name":"B","width":1}],"outputs":[{"name":"X","width":1}]},"logic":"X = A | B","description":"2-input OR gate.","tutorial":"OR is implemented as NOR+INV in CMOS — one extra inversion stage vs AND.","verilogSnippet":"sky130_fd_sc_hd__or2_1 {inst} (.A({A}), .B({B}), .X({X}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tpd_typ":0.18,"unit":"ns"}},
    {"id":"sky130_or3","abstract":"OR3","cell":"sky130_fd_sc_hd__or3_1","drive":"1","category":"combinational/gates","label":"OR3","symbol":"OR3","color":"#4ade80","ports":{"inputs":[{"name":"A","width":1},{"name":"B","width":1},{"name":"C","width":1}],"outputs":[{"name":"X","width":1}]},"logic":"X = A | B | C","description":"3-input OR gate.","tutorial":"3-input OR. Larger stack height means slower pull-down than 2-input.","verilogSnippet":"sky130_fd_sc_hd__or3_1 {inst} (.A({A}), .B({B}), .C({C}), .X({X}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tpd_typ":0.26,"unit":"ns"}},
    {"id":"sky130_xor2","abstract":"XOR2","cell":"sky130_fd_sc_hd__xor2_1","drive":"1","category":"combinational/gates","label":"XOR2","symbol":"XOR","color":"#4ade80","ports":{"inputs":[{"name":"A","width":1},{"name":"B","width":1}],"outputs":[{"name":"X","width":1}]},"logic":"X = A ^ B","description":"2-input XOR gate. Core building block of adders.","tutorial":"XOR is the most complex 2-input gate in CMOS — 4 transistors more than AND/OR. In sky130 HD, XOR2 has ~0.25ns typical delay. It is the sum-bit logic for a half adder.","verilogSnippet":"sky130_fd_sc_hd__xor2_1 {inst} (.A({A}), .B({B}), .X({X}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tpd_typ":0.25,"unit":"ns"}},
    {"id":"sky130_xnor2","abstract":"XNOR2","cell":"sky130_fd_sc_hd__xnor2_1","drive":"1","category":"combinational/gates","label":"XNOR2","symbol":"XNOR","color":"#4ade80","ports":{"inputs":[{"name":"A","width":1},{"name":"B","width":1}],"outputs":[{"name":"X","width":1}]},"logic":"X = ~(A ^ B)","description":"2-input XNOR (equivalence gate).","tutorial":"XNOR: X=1 when inputs are equal. Used in comparators, parity checkers, and error detection.","verilogSnippet":"sky130_fd_sc_hd__xnor2_1 {inst} (.A({A}), .B({B}), .X({X}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tpd_typ":0.25,"unit":"ns"}},
    {"id":"sky130_inv","abstract":"INV","cell":"sky130_fd_sc_hd__inv_1","drive":"1","category":"combinational/gates","label":"INV","symbol":"INV","color":"#4ade80","ports":{"inputs":[{"name":"A","width":1}],"outputs":[{"name":"Y","width":1}]},"logic":"Y = ~A","description":"Inverter. Fastest cell in sky130 HD.","tutorial":"INV = one PMOS + one NMOS. At drive strength 1, sky130_fd_sc_hd__inv_1 has ~0.07ns delay — the fastest available. Use INV pairs to buffer long nets.","verilogSnippet":"sky130_fd_sc_hd__inv_1 {inst} (.A({A}), .Y({Y}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tpd_typ":0.07,"unit":"ns"}},
    {"id":"sky130_nand2","abstract":"NAND2","cell":"sky130_fd_sc_hd__nand2_1","drive":"1","category":"combinational/gates","label":"NAND2","symbol":"NAND","color":"#4ade80","ports":{"inputs":[{"name":"A","width":1},{"name":"B","width":1}],"outputs":[{"name":"Y","width":1}]},"logic":"Y = ~(A & B)","description":"2-input NAND. Universal gate — faster than AND in CMOS.","tutorial":"NAND2 is FASTER than AND2 in CMOS — no inversion stage needed. Synthesisers often prefer NAND2+INV over AND2. Functionally complete: any Boolean function can be built from NANDs alone.","verilogSnippet":"sky130_fd_sc_hd__nand2_1 {inst} (.A({A}), .B({B}), .Y({Y}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tpd_typ":0.10,"unit":"ns"}},
    {"id":"sky130_nor2","abstract":"NOR2","cell":"sky130_fd_sc_hd__nor2_1","drive":"1","category":"combinational/gates","label":"NOR2","symbol":"NOR","color":"#4ade80","ports":{"inputs":[{"name":"A","width":1},{"name":"B","width":1}],"outputs":[{"name":"Y","width":1}]},"logic":"Y = ~(A | B)","description":"2-input NOR gate.","tutorial":"NOR2 is the PMOS-stack equivalent of NAND2. Slightly slower than NAND2 due to weaker PMOS pull-up. Also functionally complete.","verilogSnippet":"sky130_fd_sc_hd__nor2_1 {inst} (.A({A}), .B({B}), .Y({Y}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tpd_typ":0.12,"unit":"ns"}},
    {"id":"sky130_mux2","abstract":"MUX2","cell":"sky130_fd_sc_hd__mux2_1","drive":"1","category":"combinational/gates","label":"MUX2","symbol":"MUX","color":"#60a5fa","ports":{"inputs":[{"name":"A0","width":1},{"name":"A1","width":1},{"name":"S","width":1}],"outputs":[{"name":"X","width":1}]},"logic":"X = S ? A1 : A0","description":"2-to-1 multiplexer.","tutorial":"MUX2: X = S?A1:A0. Implemented with transmission gates in sky130 for minimal delay. MUXes are the building block of ALUs and data path selection.","verilogSnippet":"sky130_fd_sc_hd__mux2_1 {inst} (.A0({A0}), .A1({A1}), .S({S}), .X({X}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tpd_typ":0.20,"unit":"ns"}},
    {"id":"sky130_mux4","abstract":"MUX4","cell":"sky130_fd_sc_hd__mux4_1","drive":"1","category":"combinational/gates","label":"MUX4","symbol":"MUX4","color":"#60a5fa","ports":{"inputs":[{"name":"A0","width":1},{"name":"A1","width":1},{"name":"A2","width":1},{"name":"A3","width":1},{"name":"S0","width":1},{"name":"S1","width":1}],"outputs":[{"name":"X","width":1}]},"logic":"X = {S1,S0}==0?A0:==1?A1:==2?A2:A3","description":"4-to-1 multiplexer.","tutorial":"MUX4 selects one of four inputs via two select lines S1:S0. Reduces to two layers of MUX2.","verilogSnippet":"sky130_fd_sc_hd__mux4_1 {inst} (.A0({A0}), .A1({A1}), .A2({A2}), .A3({A3}), .S0({S0}), .S1({S1}), .X({X}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tpd_typ":0.32,"unit":"ns"}},
    {"id":"sky130_fa","abstract":"FA","cell":"sky130_fd_sc_hd__fa_1","drive":"1","category":"combinational/adders","label":"Full Adder","symbol":"FA","color":"#f59e0b","ports":{"inputs":[{"name":"A","width":1},{"name":"B","width":1},{"name":"CIN","width":1}],"outputs":[{"name":"SUM","width":1},{"name":"COUT","width":1}]},"logic":"SUM=A^B^CIN; COUT=(A&B)|(B&CIN)|(A&CIN)","description":"1-bit full adder — native sky130 HD cell.","tutorial":"sky130_fd_sc_hd__fa_1 is a dedicated full adder cell. Not synthesised from gates — it is a carefully optimised layout. SUM=A⊕B⊕CIN, COUT=majority(A,B,CIN). The native FA cell is faster and smaller than a gate-synthesised equivalent.","verilogSnippet":"sky130_fd_sc_hd__fa_1 {inst} (.A({A}), .B({B}), .CIN({CIN}), .SUM({SUM}), .COUT({COUT}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tpd_typ":0.35,"unit":"ns"}},
    {"id":"sky130_ha","abstract":"HA","cell":"sky130_fd_sc_hd__ha_1","drive":"1","category":"combinational/adders","label":"Half Adder","symbol":"HA","color":"#f59e0b","ports":{"inputs":[{"name":"A","width":1},{"name":"B","width":1}],"outputs":[{"name":"SUM","width":1},{"name":"COUT","width":1}]},"logic":"SUM=A^B; COUT=A&B","description":"1-bit half adder. No carry-in.","tutorial":"sky130_fd_sc_hd__ha_1 is a native half adder cell. SUM=A⊕B (XOR), COUT=A&B (AND). Use at the LSB of a ripple-carry adder chain where carry-in is always 0.","verilogSnippet":"sky130_fd_sc_hd__ha_1 {inst} (.A({A}), .B({B}), .SUM({SUM}), .COUT({COUT}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tpd_typ":0.25,"unit":"ns"}},
    {"id":"sky130_dfrtp","abstract":"DFF_R","cell":"sky130_fd_sc_hd__dfrtp_1","drive":"1","category":"sequential/flip_flops","label":"DFF (Reset)","symbol":"DFF","color":"#c084fc","ports":{"inputs":[{"name":"CLK","width":1},{"name":"D","width":1},{"name":"RESET_B","width":1}],"outputs":[{"name":"Q","width":1}]},"logic":"posedge CLK: Q <= RESET_B ? D : 0","description":"D flip-flop with active-low async reset.","tutorial":"sky130_fd_sc_hd__dfrtp_1: Positive-edge D-FF with active-LOW async reset. RESET_B=0 forces Q=0 immediately regardless of clock. '_r'=reset, '_t'=true output, '_p'=positive edge.","verilogSnippet":"sky130_fd_sc_hd__dfrtp_1 {inst} (.CLK({CLK}), .D({D}), .RESET_B({RESET_B}), .Q({Q}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tsu":0.18,"thd":0.04,"tco":0.28,"unit":"ns"}},
    {"id":"sky130_dfxtp","abstract":"DFF","cell":"sky130_fd_sc_hd__dfxtp_1","drive":"1","category":"sequential/flip_flops","label":"DFF (no reset)","symbol":"DFF0","color":"#c084fc","ports":{"inputs":[{"name":"CLK","width":1},{"name":"D","width":1}],"outputs":[{"name":"Q","width":1}]},"logic":"posedge CLK: Q <= D","description":"Simple D flip-flop, no reset. Smallest FF cell.","tutorial":"sky130_fd_sc_hd__dfxtp_1: Smallest DFF — no reset, positive edge. 'x'=no set/reset, 't'=true output. Saves area when reset is handled at block level.","verilogSnippet":"sky130_fd_sc_hd__dfxtp_1 {inst} (.CLK({CLK}), .D({D}), .Q({Q}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tsu":0.16,"thd":0.04,"tco":0.26,"unit":"ns"}},
    {"id":"sky130_sdfxtp","abstract":"SDFF","cell":"sky130_fd_sc_hd__sdfxtp_1","drive":"1","category":"sequential/flip_flops","label":"Scan DFF","symbol":"SDFF","color":"#f472b6","ports":{"inputs":[{"name":"CLK","width":1},{"name":"D","width":1},{"name":"SCD","width":1},{"name":"SCE","width":1}],"outputs":[{"name":"Q","width":1}]},"logic":"posedge CLK: Q <= SCE ? SCD : D","description":"Scan-enabled D flip-flop for DFT. SCE=1 selects scan data.","tutorial":"sky130_fd_sc_hd__sdfxtp_1: Scan DFF for Design for Testability. SCE=1 → Q captures SCD (scan chain). SCE=0 → normal (Q captures D). Connect SCD to Q of previous FF in scan chain.","verilogSnippet":"sky130_fd_sc_hd__sdfxtp_1 {inst} (.CLK({CLK}), .D({D}), .SCD({SCD}), .SCE({SCE}), .Q({Q}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tsu":0.18,"thd":0.04,"tco":0.28,"unit":"ns"}},
    {"id":"sky130_buf","abstract":"BUF","cell":"sky130_fd_sc_hd__buf_1","drive":"1","category":"combinational/utility","label":"Buffer","symbol":"BUF","color":"#94a3b8","ports":{"inputs":[{"name":"A","width":1}],"outputs":[{"name":"X","width":1}]},"logic":"X = A","description":"Buffer — two inverters. Drives heavy loads.","tutorial":"BUF = INV+INV = non-inverting driver. Use to buffer clock nets or long wires with many fanouts.","verilogSnippet":"sky130_fd_sc_hd__buf_1 {inst} (.A({A}), .X({X}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tpd_typ":0.14,"unit":"ns"}},
    {"id":"sky130_clkbuf","abstract":"CLKBUF","cell":"sky130_fd_sc_hd__clkbuf_1","drive":"1","category":"combinational/utility","label":"Clock Buffer","symbol":"CKBUF","color":"#facc15","ports":{"inputs":[{"name":"A","width":1}],"outputs":[{"name":"X","width":1}]},"logic":"X = A","description":"Clock-optimised buffer. Low skew, symmetric rise/fall.","tutorial":"CLKBUF cells are specially characterised for clock distribution. Matched rise/fall delays. Use exclusively in clock networks — never use regular BUF on clock nets.","verilogSnippet":"sky130_fd_sc_hd__clkbuf_1 {inst} (.A({A}), .X({X}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tpd_typ":0.14,"unit":"ns"}},
    {"id":"sky130_conb","abstract":"TIE","cell":"sky130_fd_sc_hd__conb_1","drive":"1","category":"combinational/utility","label":"Tie Cell","symbol":"TIE","color":"#94a3b8","ports":{"inputs":[],"outputs":[{"name":"HI","width":1},{"name":"LO","width":1}]},"logic":"HI=1; LO=0","description":"Tie-high and tie-low outputs. Use for constant logic values.","tutorial":"In real silicon, connecting an input directly to VPWR/VGND can cause reliability issues. Use CONB to generate constant HI and LO signals safely. OpenLane inserts these automatically.","verilogSnippet":"sky130_fd_sc_hd__conb_1 {inst} (.HI({HI}), .LO({LO}), .VPWR(VPWR), .VGND(VGND), .VPB(VPWR), .VNB(VGND));","timingHint":{"tpd_typ":0.0,"unit":"ns"}}
  ]
}
