{
  "name": "verilog-blocks-ide",
  "version": "2.0.0",
  "description": "Drag-and-drop Verilog block diagram editor for open-source ASIC education",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "server": "node server/server.js",
    "docker": "npm run build && node server/server.js",
    "electron": "electron .",
    "test": "node --test",
    "start": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:dist": "npm run build && electron . --use-dist",
    "smoke": "npm run build && electron . --smoke-test",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reactflow": "11.11.4",
    "zustand": "4.5.5",
    "express": "4.22.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "5.4.21",
    "concurrently": "8.2.2",
    "wait-on": "7.2.0",
    "electron": "33.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.rohitlalu.vbide",
    "productName": "VerilogBlocks IDE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "server/**/*.js",
      "pdk/**",
      "!pdk/user-blocks/**",
      "!server/server.js",
      "!server/security.js",
      "!node_modules/**/*",
      "electron-main.js",
      "preload.js",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage"
      ]
    }
  }
}
